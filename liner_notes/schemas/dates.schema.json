{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/jampick/liner-notes/schemas/dates.schema.json",
 "title": "Each song's year in a journey, with where it came from",
 "description": "MusicBrainz is only the first guess; a writer or a person corrects it, and corrected_from keeps the old year. A year nobody could find is null, never made up.",
 "type": "object",
 "required": ["songs"],
 "properties": {
  "songs": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": ["song", "year", "source", "confidence"],
    "properties": {
     "song": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*--[a-z0-9]+(-[a-z0-9]+)*$"},
     "year": {"type": ["integer", "null"], "minimum": 1800},
     "source": {"enum": ["musicbrainz", "writer", "person", null]},
     "confidence": {"enum": ["high", "medium", "low", "none"]},
     "url": {"type": "string"},
     "note": {"type": "string"},
     "corrected_from": {"type": ["integer", "null"]}
    }
   }
  }
 }
}
