{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/jampick/liner-notes/schemas/song.schema.json",
 "title": "A song in the Liner Notes song bank",
 "type": "object",
 "required": ["id", "title", "artist", "year", "aliases", "notes", "review", "provenance"],
 "properties": {
  "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*--[a-z0-9]+(-[a-z0-9]+)*(--[0-9]{4})?$"},
  "title": {"type": "string", "minLength": 1},
  "artist": {"type": "string", "minLength": 1},
  "year": {"type": "integer", "minimum": 0},
  "year_note": {"type": "string"},
  "album": {"type": "string"},
  "mbid": {"type": "string"},
  "isrc": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]{2}[A-Z0-9]{3}[0-9]{7}$"}},
  "aliases": {
   "type": "object",
   "properties": {
    "youtube": {"type": "array", "items": {"type": "string", "pattern": "^[\\w-]{11}$"}},
    "apple": {"type": "object", "properties": {"preview": {"type": "string"}, "url": {"type": "string"}}},
    "spotify": {"type": "array", "items": {"type": "string"}},
    "tidal": {"type": "array", "items": {"type": "string"}},
    "qobuz": {"type": "array", "items": {"type": "string"}},
    "navidrome": {"type": "array", "items": {"type": "string"}},
    "local": {"type": "array", "items": {"type": "string"}},
    "titles": {"type": "array", "items": {"type": "string"}},
    "artists": {"type": "array", "items": {"type": "string"}}
   }
  },
  "notes": {
   "type": "object",
   "properties": {
    "made": {"type": "string"},
    "context": {"type": "string"},
    "listen_for": {"type": "array", "items": {"type": "object", "required": ["where", "note"], "properties": {"where": {"type": "string"}, "note": {"type": "string"}}}},
    "leads_to": {"type": "object"},
    "sources": {"type": "array", "items": {"type": "string", "pattern": "^https?://"}},
    "unverified": {"type": "string"}
   }
  },
  "culture": {"type": "array", "items": {"type": "object", "required": ["kind", "title", "line"]}},
  "review": {
   "type": "object",
   "required": ["state"],
   "properties": {"state": {"enum": ["draft", "reviewed"]}, "by": {"type": ["string", "null"]}, "date": {"type": ["string", "null"]}}
  },
  "provenance": {
   "type": "object",
   "required": ["ai_generated"],
   "properties": {"ai_generated": {"type": "boolean"}, "model": {"type": "string"}, "written_by": {"type": ["string", "null"]}, "written_on": {"type": ["string", "null"]}}
  }
 }
}
