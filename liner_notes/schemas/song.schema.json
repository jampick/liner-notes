{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/jampick/liner-notes/schemas/song.schema.json",
 "title": "A song in the Liner Notes song bank",
 "type": "object",
 "required": ["id", "title", "artist", "year", "aliases", "notes", "review", "provenance"],
 "properties": {
  "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*--[a-z0-9]+(-[a-z0-9]+)*(--[0-9]{4})?$"},
  "title": {"type": "string", "minLength": 1},
  "artist": {"type": "string", "minLength": 1},
  "year": {"type": ["integer", "null"], "minimum": 1800},
  "year_source": {
   "description": "Where the year came from: musicbrainz (the first release of the song's release group), writer (the notes' writer, with sources), person (set by hand). null when nobody found a year. Songs written before the field existed don't have it.",
   "enum": ["musicbrainz", "writer", "person", null]
  },
  "year_musicbrainz": {"description": "MusicBrainz's year, kept when the writer's year replaced it, so check can show both.", "type": "integer"},
  "base": {
   "description": "On your copy of a shipped song: where it started. version is the package version, sha256 the shipped file's bytes, content the song apart from review and base when it was copied (copies made before 0.3.0.dev0 don't have content).",
   "type": "object",
   "required": ["version", "sha256"],
   "properties": {
    "version": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "content": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
   }
  },
  "release_group": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
  "year_note": {"type": "string"},
  "album": {"type": "string"},
  "mbid": {"type": "string"},
  "isrc": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]{2}[A-Z0-9]{3}[0-9]{7}$"}},
  "aliases": {
   "type": "object",
   "properties": {
    "youtube": {"type": "array", "items": {"type": "string", "pattern": "^[\\w-]{11}$"}},
    "apple": {"type": "object", "properties": {"preview": {"type": "string"}, "url": {"type": "string"}}},
    "spotify": {"type": "array", "items": {"type": "string"}},
    "tidal": {"type": "array", "items": {"type": "string"}},
    "qobuz": {"type": "array", "items": {"type": "string"}},
    "navidrome": {"type": "array", "items": {"type": "string"}},
    "local": {"type": "array", "items": {"type": "string"}},
    "titles": {"type": "array", "items": {"type": "string"}},
    "artists": {"type": "array", "items": {"type": "string"}}
   }
  },
  "notes": {
   "type": "object",
   "properties": {
    "made": {"type": "string"},
    "context": {"type": "string"},
    "listen_for": {"type": "array", "items": {"type": "object", "required": ["where", "note"], "properties": {"where": {"type": "string"}, "note": {"type": "string"}}}},
    "leads_to": {"type": "object"},
    "sources": {"type": "array", "items": {"type": "string", "pattern": "^https?://"}},
    "unverified": {"type": "string"}
   }
  },
  "culture": {"type": "array", "items": {"type": "object", "required": ["kind", "title", "line"]}},
  "review": {
   "type": "object",
   "required": ["state"],
   "properties": {"state": {"enum": ["draft", "reviewed"]}, "by": {"type": ["string", "null"]}, "date": {"type": ["string", "null"]}}
  },
  "provenance": {
   "type": "object",
   "required": ["ai_generated"],
   "properties": {"ai_generated": {"type": "boolean"}, "model": {"type": "string"}, "written_by": {"type": ["string", "null"]}, "written_on": {"type": ["string", "null"]}}
  }
 }
}
