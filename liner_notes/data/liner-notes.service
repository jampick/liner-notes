# The Liner Notes bridge as a systemd user service, so it is there after a login and comes back
# by itself if it dies. Installed by `liner-notes service install`, which copies this file to
# ~/.config/systemd/user/liner-notes.service and replaces:
#
#   @PYTHON@   the full path of the Python that has liner_notes installed (sys.executable of the
#              liner-notes that ran the install, e.g. ~/Projects/liner-notes/.venv/bin/python)
#
# Logs go to the journal: journalctl --user -u liner-notes -f
# More detail: systemctl --user edit liner-notes, then Environment=LINER_NOTES_LOG=DEBUG

[Unit]
Description=Liner Notes bridge between journey pages and cliamp (127.0.0.1:47391)
Documentation=https://github.com/jampick/liner-notes
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
ExecStart=@PYTHON@ -m liner_notes serve
Restart=on-failure
RestartSec=2
Environment=PYTHONUNBUFFERED=1
Environment=LINER_NOTES_LOG=INFO
NoNewPrivileges=yes

[Install]
WantedBy=default.target
