{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/jampick/liner-notes/schemas/remix-journey.schema.json",
 "title": "A Liner Notes remix journey: remixes, each laid against the original it flips",
 "type": "object",
 "required": ["slug", "kind", "title", "description", "songs", "remixes"],
 "properties": {
  "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
  "kind": {"type": "string", "enum": ["remix"]},
  "title": {"type": "string", "minLength": 1},
  "songs": {"type": "array", "items": {"type": "string"}},
  "remixes": {
   "type": "array", "minItems": 1,
   "items": {
    "type": "object", "required": ["title", "song", "artist", "path", "id", "original"],
    "properties": {
     "id": {"type": "string", "pattern": "^([\\w-]{11}|\\d+)$"},
     "path": {"type": "string", "pattern": "^https://"},
     "volume": {"type": "integer", "minimum": 1},
     "original": {"type": "object"}
    }
   }
  },
  "panel": {"type": "object", "properties": {"quotes": {"type": "object"}}},
  "review": {"type": "object"}
 }
}
